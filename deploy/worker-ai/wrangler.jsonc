// Mirrors the live "ai" Worker settings (2026-10-27). Secrets are not stored here:
// CF_ACCOUNT_ID, CF_API_TOKEN, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, PHONE_MCP_TOKEN,
// ROUTERPI_KEY, ROUTERPI_ACCESS_ID, ROUTERPI_ACCESS_SECRET, ERX_KEY, ERX_ACCESS_ID, ERX_ACCESS_SECRET,
// AZURE_KEY, AZURE_ACCESS_ID, AZURE_ACCESS_SECRET
{
  "name": "ai",
  "main": "index.js",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  // Off so the Access app "Sentinel MCP Worker" (mcp/ai.ettzz.pro) can't be bypassed via workers.dev
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "mcp.ettzz.pro", "custom_domain": true },
    { "pattern": "ai.ettzz.pro", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "9f59da2f46e54378afe15db754cafb09" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
